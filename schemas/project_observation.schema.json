{
  "$defs": {
    "ConfidenceLevel": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "FieldProvenance": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "origin": {
          "enum": [
            "normalized",
            "derived_from_source",
            "deterministic_rule"
          ],
          "title": "Origin",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "source_fields": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Fields",
          "type": "array"
        }
      },
      "required": [
        "origin",
        "source_fields"
      ],
      "title": "FieldProvenance",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "valid",
        "review",
        "invalid"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
